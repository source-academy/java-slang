{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "es2021.string", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/conductor/**/*.ts"]
}
