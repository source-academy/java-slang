{
  "name": "java-slang",
  "version": "1.0.14",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-academy/java-slang.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc --build --force",
    "build:lib-info": "tsc --build --force && node dist/compiler/import/build-lib-info.js",
    "build:conductor": "rollup -c rollup.config.conductor.mjs",
    "typecheck:conductor": "tsc --noEmit -p tsconfig.conductor.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:conductor": "node --experimental-vm-modules node_modules/.bin/jest --config jest.conductor.config.mjs",
    "jsdoc": "typedoc --plugin typedoc-plugin-rename-defaults",
    "eslint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext \".ts\" src",
    "format": "prettier --write src/**/*.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^29.5.4",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^29.6.4",
    "prettier": "^3.2.5",
    "rollup": "^4.63.5",
    "ts-jest": "^29.1.1",
    "tslib": "^2.8.1",
    "typedoc": "^0.25.12",
    "typedoc-plugin-markdown": "^3.17.1",
    "typedoc-plugin-rename-defaults": "^0.7.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@sourceacademy/conductor": "^0.8.3",
    "@types/lodash": "^4.14.198",
    "java-parser": "^2.0.5",
    "lodash": "^4.17.21",
    "peggy": "^4.0.2"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
